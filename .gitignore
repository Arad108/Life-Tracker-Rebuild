# This repository holds the rebuild source, not the reverse-engineering artefacts.
# The APK, decompiled bundle, disassembly and analysis dumps stay local.
/*
!/.gitignore
!/fin-core/
!/life-tracker/
# Keep build outputs and dependencies out of git
/life-tracker/node_modules/
/life-tracker/.expo/
/life-tracker/android/
/life-tracker/ios/
/life-tracker/dist/
/life-tracker/*.jks
/life-tracker/*.keystore
